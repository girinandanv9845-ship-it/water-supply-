{
  "name": "aquaflow-water-delivery",
  "version": "2.0.0",
  "private": true,
  "description": "AquaFlow - production-ready water tanker booking & delivery platform",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.18"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "db:setup": "prisma migrate deploy && node prisma/seed.js",
    "test": "node --test tests/*.test.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "db:clean": "node prisma/clean.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.0",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^6.16.2",
    "socket.io-client": "^4.8.3"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  },
  "overrides": {
    "qs": "^6.16.0",
    "deepmerge-ts": "^8.0.0"
  }
}
