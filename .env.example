# ============================================================
# AquaFlow - environment configuration
# Copy this file to .env and fill in real values.
#   cp .env.example .env          (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
# NEVER commit .env - it is listed in .gitignore.
# ============================================================

# ---------- core ----------
NODE_ENV=development
PORT=3000

# ---------- database (PostgreSQL) ----------
# Docker compose (recommended): port 5434, credentials set in docker-compose.yml
#   postgresql://aquaflow:aquaflow_dev_password@localhost:5434/water_app
# Native local install: postgresql://USER:PASSWORD@localhost:5432/water_app
DATABASE_URL=postgresql://aquaflow:aquaflow_dev_password@localhost:5434/water_app

# ---------- auth ----------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OTP behaviour
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---------- demo mode ----------
# true  -> mock OTP is returned in the API response, payments are simulated.
# Automatically FORCED OFF when NODE_ENV=production.
DEMO_MODE=true

# ---------- seed accounts ----------
ADMIN_SEED_PHONE=9000000001
# Leave blank and the seed prints a generated password once.
ADMIN_SEED_PASSWORD=
DRIVER_SEED_PHONE=9000000002

# ---------- CORS ----------
# Required in production. Comma-separated. Empty = permissive (dev only).
CORS_ORIGINS=
# Set to true when running behind nginx / a PaaS load balancer.
TRUST_PROXY=false

# ---------- Google Maps ----------
# Browser key. Enable: Maps JavaScript API, Places API, Geocoding API.
# Restrict it by HTTP referrer to your own domains in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# ---------- Razorpay ----------
# Dashboard -> Settings -> API Keys. The SECRET stays server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=

# ---------- AI support chatbot ----------
# AI_PROVIDER: anthropic | openai | none
# With "none" (or no key) the bot uses the built-in rule-based knowledge base.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5
# Only for OpenAI-compatible gateways:
# AI_BASE_URL=https://api.openai.com/v1

# ---------- SMS gateway (real OTP delivery) ----------
# Leave SMS_PROVIDER blank and, in development only, the OTP is shown on screen.
# Set a provider and its credentials and the code is texted to the customer's
# phone instead - never returned to the browser, never written to the log.
# Production refuses to start without one of these configured.
#
# IMPORTANT for India: transactional SMS requires DLT registration with TRAI
# (register your entity, sender ID and message template on your operator's DLT
# portal). Without it messages are accepted by the gateway but never delivered.
#
# SMS_PROVIDER: msg91 | twilio | fast2sms | webhook   (blank = auto-detect)
SMS_PROVIDER=
SMS_SENDER_NAME=AquaFlow
SMS_COUNTRY_CODE=91
# Optional custom text. {code} and {minutes} are substituted.
# Must match your approved DLT template wording.
SMS_OTP_TEMPLATE=

# --- MSG91 (recommended in India) --- msg91.com
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# --- Twilio --- twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Fast2SMS (India only) --- fast2sms.com
FAST2SMS_API_KEY=
FAST2SMS_SENDER_ID=
FAST2SMS_MESSAGE_ID=

# --- Any other gateway: we POST {to, message, code} to your endpoint ---
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# ---------- EMAIL OTP (easiest real option - no DLT paperwork) ----------
# Customers can sign in with an email address instead of a phone number and
# receive the code in their inbox. Gmail works out of the box and is free.
#
# GMAIL SETUP (5 minutes):
#   1. Enable 2-Step Verification on the Google account:
#      https://myaccount.google.com/security
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#      (pick "Mail" -> "Other" -> name it AquaFlow)
#   3. Paste the 16-character password below - NOT your normal Gmail password,
#      Google rejects that for SMTP.
#
# EMAIL_PROVIDER: gmail | smtp | resend | webhook   (blank = auto-detect)
EMAIL_PROVIDER=
EMAIL_SENDER_NAME=AquaFlow
EMAIL_FROM=

# --- Gmail ---
GMAIL_USER=
GMAIL_APP_PASSWORD=

# --- Any other SMTP server (Outlook, Zoho, Mailgun, SES, ...) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Resend (HTTP API - useful where SMTP ports are blocked) ---
RESEND_API_KEY=

# --- Any other mail service: we POST {to, subject, message} to your endpoint ---
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=

# ---------- order-update notifications ----------
# Which channels order status changes go out on. IN_APP is always included.
# SMS and EMAIL reuse the gateways configured above, so no extra credentials.
# Opt in deliberately: a delivery has six status changes, so EMAIL means six
# emails and SMS means six paid messages per order.
#   NOTIFY_CHANNELS=IN_APP,EMAIL
NOTIFY_CHANNELS=IN_APP

# Not yet implemented - declared so the wiring is obvious.
WHATSAPP_PROVIDER_KEY=
PUSH_PROVIDER_KEY=

# ---------- support contact shown by the chatbot ----------
SUPPORT_PHONE=
SUPPORT_EMAIL=

# ---------- tuning ----------
# Minimum ms between accepted driver GPS updates (server-enforced throttle).
LOCATION_MIN_INTERVAL_MS=3000
# LOG_FORMAT=json
# LOG_LEVEL=debug
