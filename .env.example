# ============================================================
# AquaFlow - environment configuration
# Copy this file to .env and fill in real values.
#   cp .env.example .env          (macOS/Linux)
#   Copy-Item .env.example .env   (Windows PowerShell)
# NEVER commit .env - it is listed in .gitignore.
# ============================================================

# ---------- core ----------
NODE_ENV=development
PORT=3000

# ---------- database (PostgreSQL) ----------
# Docker compose (recommended): port 5434, credentials set in docker-compose.yml
#   postgresql://aquaflow:aquaflow_dev_password@localhost:5434/water_app
# Native local install: postgresql://USER:PASSWORD@localhost:5432/water_app
DATABASE_URL=postgresql://aquaflow:aquaflow_dev_password@localhost:5434/water_app

# ---------- auth ----------
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# OTP behaviour
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# ---------- demo mode ----------
# true  -> mock OTP is returned in the API response, payments are simulated.
# Automatically FORCED OFF when NODE_ENV=production.
DEMO_MODE=true

# ---------- seed accounts ----------
ADMIN_SEED_PHONE=9000000001
# Leave blank and the seed prints a generated password once.
ADMIN_SEED_PASSWORD=
DRIVER_SEED_PHONE=9000000002

# ---------- CORS ----------
# Required in production. Comma-separated. Empty = permissive (dev only).
CORS_ORIGINS=
# Set to true when running behind nginx / a PaaS load balancer.
TRUST_PROXY=false

# ---------- Google Maps ----------
# Browser key. Enable: Maps JavaScript API, Places API, Geocoding API.
# Restrict it by HTTP referrer to your own domains in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# ---------- Razorpay ----------
# Dashboard -> Settings -> API Keys. The SECRET stays server-side only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=

# ---------- AI support chatbot ----------
# AI_PROVIDER: anthropic | openai | none
# With "none" (or no key) the bot uses the built-in rule-based knowledge base.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=claude-opus-5
# Only for OpenAI-compatible gateways:
# AI_BASE_URL=https://api.openai.com/v1

# ---------- optional notification providers ----------
# Leave blank to use in-app notifications only.
SMS_PROVIDER_KEY=
WHATSAPP_PROVIDER_KEY=
PUSH_PROVIDER_KEY=
SMTP_URL=

# ---------- support contact shown by the chatbot ----------
SUPPORT_PHONE=
SUPPORT_EMAIL=

# ---------- tuning ----------
# Minimum ms between accepted driver GPS updates (server-enforced throttle).
LOCATION_MIN_INTERVAL_MS=3000
# LOG_FORMAT=json
# LOG_LEVEL=debug
