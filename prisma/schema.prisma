// AquaFlow - Water Tanker Delivery Platform
// Database: PostgreSQL   ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/* ========================= ENUMS ========================= */

enum Role {
  CUSTOMER
  DRIVER
  ADMIN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DRIVER_ASSIGNED
  DRIVER_ACCEPTED
  OUT_FOR_DELIVERY
  ARRIVING
  DELIVERED
  CANCELLED
  FAILED
  PAYMENT_FAILED
}

enum PaymentMethod {
  ONLINE
  CASH_ON_DELIVERY
}

enum PaymentStatus {
  PENDING
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum VehicleStatus {
  ACTIVE
  IN_MAINTENANCE
  INACTIVE
}

enum DriverStatus {
  OFFLINE
  AVAILABLE
  ON_DELIVERY
  SUSPENDED
}

enum NotificationChannel {
  IN_APP
  SMS
  WHATSAPP
  EMAIL
  PUSH
}

/* ========================= IDENTITY ========================= */

model User {
  id   String @id @default(cuid())
  name String
  // A customer signs up with a phone OR an email; at least one is always
  // present, and either can be used to receive a login code.
  phone String? @unique
  email String? @unique
  role         Role     @default(CUSTOMER)
  // Only ever populated for ADMIN accounts (bcrypt hash). Customers/drivers use OTP.
  passwordHash String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  addresses      Address[]
  customerOrders Order[]               @relation("CustomerOrders")
  driverProfile  DriverProfile?
  notifications  Notification[]
  conversations  SupportConversation[]
  otpChallenges  OtpChallenge[]

  @@index([role])
  @@index([createdAt])
}

enum OtpChannel {
  SMS
  EMAIL
}

model OtpChallenge {
  id String @id @default(cuid())
  /// The phone number or email address the code was sent to.
  identifier String
  channel    OtpChannel @default(SMS)
  codeHash   String
  purpose    String     @default("LOGIN")
  attempts   Int        @default(0)
  consumedAt DateTime?
  expiresAt  DateTime
  createdAt  DateTime   @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([identifier, expiresAt])
}

/* ========================= ADDRESSES ========================= */

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String   @default("Home")
  fullAddress String
  landmark    String?
  latitude    Float
  longitude   Float
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
}

/* ========================= CATALOG ========================= */

model Product {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  description  String?
  capacityL    Int
  priceInPaise Int
  vehicleType  String   @default("TANKER")
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  imageEmoji   String   @default("droplet")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]

  @@index([isActive, sortOrder])
}

model ServiceArea {
  id        String   @id @default(cuid())
  name      String
  pincode   String?
  centerLat Float
  centerLng Float
  radiusKm  Float    @default(15)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/// A filling point tankers load from. Each order is matched to the nearest
/// active station at booking time, which becomes the origin of the delivery
/// route the customer sees on the tracking map.
model WaterStation {
  id        String   @id @default(cuid())
  name      String
  address   String?
  latitude  Float
  longitude Float
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@index([isActive])
}

/* ========================= FLEET ========================= */

model DriverProfile {
  id              String       @id @default(cuid())
  userId          String       @unique
  licenseNumber   String?
  licenseExpiry   DateTime?
  status          DriverStatus @default(OFFLINE)
  isVerified      Boolean      @default(false)
  currentLat      Float?
  currentLng      Float?
  heading         Float?
  lastLocationAt  DateTime?
  totalDeliveries Int          @default(0)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicles Vehicle[]
  orders   Order[]   @relation("DriverOrders")

  @@index([status])
}

model Vehicle {
  id                 String        @id @default(cuid())
  registrationNumber String        @unique
  vehicleType        String        @default("TANKER")
  capacityL          Int
  status             VehicleStatus @default(ACTIVE)
  driverId           String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  driver DriverProfile? @relation(fields: [driverId], references: [id], onDelete: SetNull)
  orders Order[]

  @@index([status])
  @@index([driverId])
}

/* ========================= ORDERS ========================= */

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique
  customerId  String
  driverId    String?
  vehicleId   String?
  addressId   String
  productId   String
  stationId   String?

  // Snapshot of catalog data at purchase time - price history must be immutable.
  loadType         String
  quantityL        Int
  unitPriceInPaise Int
  quantity         Int    @default(1)
  totalInPaise     Int

  status        OrderStatus   @default(PENDING)
  paymentMethod PaymentMethod @default(ONLINE)

  // Denormalised delivery coordinates so tracking never needs the address join.
  latitude            Float
  longitude           Float
  deliveryAddressText String

  estimatedArrival DateTime?
  scheduledFor     DateTime?
  notes            String?
  cancelReason     String?

  confirmedAt DateTime?
  assignedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User           @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  driver   DriverProfile? @relation("DriverOrders", fields: [driverId], references: [id], onDelete: SetNull)
  vehicle  Vehicle?       @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  address  Address        @relation(fields: [addressId], references: [id])
  product  Product        @relation(fields: [productId], references: [id])
  station  WaterStation?  @relation(fields: [stationId], references: [id], onDelete: SetNull)

  payments Payment[]
  events   OrderEvent[]

  @@index([customerId, createdAt])
  @@index([driverId, status])
  @@index([status, createdAt])
  @@index([createdAt])
}

model OrderEvent {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  note      String?
  actorId   String?
  actorRole Role?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

/* ========================= PAYMENTS ========================= */

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  amountInPaise     Int
  currency          String        @default("INR")
  provider          String        @default("razorpay")
  providerOrderId   String?       @unique
  providerPaymentId String?       @unique
  signature         String?
  status            PaymentStatus @default(PENDING)
  isDemo            Boolean       @default(false)
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
}

/* ========================= SUPPORT & NOTIFICATIONS ========================= */

model SupportConversation {
  id        String   @id @default(cuid())
  userId    String?
  title     String   @default("Support chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages SupportMessage[]

  @@index([userId, updatedAt])
}

model SupportMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String // "user" | "assistant"
  content        String
  createdAt      DateTime @default(now())

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  title     String
  body      String
  channel   NotificationChannel @default(IN_APP)
  orderId   String?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/* ========================= SETTINGS ========================= */

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}
